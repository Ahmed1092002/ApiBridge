{
  "name": "@ahmed109/apibridge-react",
  "version": "1.0.2",
  "description": "TanStack Query typed client and React hooks for ApiBridge contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmed1092002/ApiBridge.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Ahmed1092002/ApiBridge/issues"
  },
  "homepage": "https://github.com/Ahmed1092002/ApiBridge#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts --external react",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ahmed109/apibridge-contracts": "workspace:^1.0.0",
    "@tanstack/react-query": "^5.62.7"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
