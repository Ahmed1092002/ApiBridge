{
  "name": "@ahmed109/apibridge-express",
  "version": "1.0.1",
  "description": "Express adapter and OpenAPI generator for ApiBridge contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmed1092002/ApiBridge.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/Ahmed1092002/ApiBridge/issues"
  },
  "homepage": "https://github.com/Ahmed1092002/ApiBridge#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ahmed109/apibridge-contracts": "workspace:^1.0.0",
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
